    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jaaayden/obsidian-snippet-palette.git"
  }
