{
  "name": "obsidian-snippet-palette",
  "version": "1.0.0",
  "description": "A colorful, dockable snippet palette for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
